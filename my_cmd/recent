#!/bin/bash
# 用法: ./recent_files.sh [目录] [数量]

SEARCH_DIR="${1:-.}"  # 默认当前目录
COUNT="${2:-10}"      # 默认显示10个

find "$SEARCH_DIR" -type f -printf "%T@ %p\0" 2>/dev/null | \
    sort -nrz | \
    head -z -n "$COUNT" | \
    while IFS= read -r -d '' line; do
        timestamp="${line%% *}"
        filepath="${line#* }"
        # 转换为可读时间
        mod_time=$(date -d "@${timestamp}" "+%Y-%m-%d %H:%M:%S")
        # 用颜色区分新旧 (红色较新)
        age_seconds=$(( $(date +%s) - ${timestamp%.*} ))
        if [[ $age_seconds -lt 3600 ]]; then
            color="\033[31m"  # 红色: 1小时内
        elif [[ $age_seconds -lt 86400 ]]; then
            color="\033[33m"  # 黄色: 24小时内
        else
            color="\033[0m"   # 默认: 更早
        fi
        echo -e "${color}${mod_time}  ${filepath}\033[0m"
    done
